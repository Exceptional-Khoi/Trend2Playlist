# Sao chép thành .env rồi điền (tuỳ chọn). scripts/deploy.sh sẽ tạo Secret "music-secrets" từ file này.
# Hệ thống vẫn chạy đầy đủ khi để trống: bình luận YouTube lấy qua youtube-comment-downloader.

# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# KHUYẾN NGHỊ MẠNH vì endpoint web của YouTube Charts có thể trả 429 theo IP:
#   - fallback sang videos.list(chart=mostPopular, category=Music, region=VN), 1 request/lần crawl chart
#   - lấy bình luận ổn định qua commentThreads.list
#   - bật được CronJob crawl-geo (chỉ là video có geotag gần tỉnh, KHÔNG phải vị trí người nghe)
# Quota mặc định hiện tại: 100 search.list/ngày và 10.000 units/ngày cho các endpoint còn lại.
YOUTUBE_API_KEY=

# Khoá API web của Zing MP3 (giá trị công khai trong JS của zingmp3.vn). Chỉ cần điền khi Zing đổi khoá.
# ZING_API_KEY=
# ZING_SECRET_KEY=
# ZING_VERSION=

# Thêm playlist Spotify để lấy dữ liệu đồng xuất hiện: "id1:Tên 1,id2:Tên 2"
# SPOTIFY_EXTRA_PLAYLISTS=

# Google Trends API chính thức hiện ở giai đoạn alpha, phải đăng ký quyền truy cập riêng.
# Crawler hiện dùng endpoint web công khai, không có API key; không điền cookie/tài khoản Google vào đây.

# Mặc định một nguồn lỗi vẫn giữ dữ liệu các nguồn khác và CronJob thành công (fault isolation).
# Đặt true cho CI nếu muốn bất kỳ lỗi nguồn nào cũng làm process exit 1.
# FAIL_ON_PARTIAL=false
